extends ../../layout/default.pug

block main
  h2 Trang danh sách sản phẩm

  .card.mb-3
    .card-header Bộ lọc và Tìm kiếm
    .card-body
      .row
        .col-6
          each item in filerStatus
            button(
              class=`btn btn-sm ml-1 btn-outline-success ${item.class}`,
              button-status=item.status
            ) #{item.name}
        .col-6
          form#form-search
            .input-group
              input.form-control(
                type="text",
                name="keyword",
                value=keyword
                placeholder="Nhập từ khóa"
              )
              .input-group-append
                button.btn.btn-success(type="submit") Tìm 

  .card.mb-3
    .card-header Danh sách
    .card-body
      table.table.table-hover.table-sm
        thead
          tr
            th STT
            th Hình ảnh
            th Tiêu đề
            th Giá
            th Trạng thái
            th Hành động
        tbody
          each item, index in products
            tr
              td #{index + 1}
              td
                img(
                  src=item.thumbnail,
                  alt=item.title,
                  width="80px",
                  height="80px"
                )
              td #{item.title}
              td #{item.pricenew}$
              td
                if item.status == "active"
                  a.bg-primary.text-white(href="#") Hoạt động
                else
                  a.bg-danger.text-white(href="#") Dừng Hoạt động
              td
                button.btn.btn-warning.btn-sm Sửa
                button.btn.btn-danger.btn-sm.ml-1 Xóa
